{
  "auto-code-harvester": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python scripts/auto_skill_router_hook.py",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/unified_stop_pipeline.py",
        "timeout": 60
      }
    ]
  },
  "universal-quality-gate": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "python scripts/gate_tracker.py",
        "timeout": 5,
        "matcher": "write_file|edit_file|run_command"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/gate_enforcer.py",
        "timeout": 25
      }
    ]
  }
}
